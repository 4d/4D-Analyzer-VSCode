{
	"compilerOptions": {
		"module": "node16",
		"target": "es2022",
		"lib": [
			"ES2022"
		],
		"outDir": "out",
		"rootDir": "src",
		"sourceMap": true,
		"moduleResolution": "node16",
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}